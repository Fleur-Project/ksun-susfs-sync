From 83b608fb67a1d555269b2d035e698f9b4c0fcb65 Mon Sep 17 00:00:00 2001
From: Alhaidar Latif <ziyalhaidar@gmail.com>
Date: Fri, 23 Oct 2026 20:39:31 +0700
Subject: [PATCH] configs: Enable KernelSU and SuSFS configuration

Signed-off-by: Alhaidar Latif <ziyalhaidar@gmail.com>
---
 arch/arm64/configs/vendor/garnet_GKI.config | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/arch/arm64/configs/vendor/garnet_GKI.config b/arch/arm64/configs/vendor/garnet_GKI.config
index 4e188282c710..a8ac608291fa 100644
--- a/arch/arm64/configs/vendor/garnet_GKI.config
+++ b/arch/arm64/configs/vendor/garnet_GKI.config
@@ -60,6 +60,26 @@ CONFIG_TOUCHSCREEN_XIAOMI_TOUCHFEATURE=m
 CONFIG_USB_NET_AX88179_178A=m
 CONFIG_USB_NET_AX8817X=m
 
+# Extras
+CONFIG_OVERLAY_FS_XINO_AUTO=y
+CONFIG_KALLSYMS=y
+CONFIG_TMPFS_POSIX_ACL=y
+
+# KSU
+CONFIG_KSU=y
+
+# SUSFS
+CONFIG_KSU_SUSFS=y
+CONFIG_KSU_SUSFS_SUS_PATH=y
+CONFIG_KSU_SUSFS_SUS_MOUNT=y
+CONFIG_KSU_SUSFS_SUS_KSTAT=y
+CONFIG_KSU_SUSFS_SPOOF_UNAME=y
+CONFIG_KSU_SUSFS_ENABLE_LOG=y
+CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
+CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
+CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
+CONFIG_KSU_SUSFS_SUS_MAP=y
+
 # Local Version
 CONFIG_LOCALVERSION_AUTO=n
 CONFIG_LOCALVERSION="-FleurX"
-- 
